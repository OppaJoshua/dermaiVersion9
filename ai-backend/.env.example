# ============================================
# DERMAI AI BACKEND - Environment Configuration Template
# ============================================

# Model Configuration
MODEL_PATH=./models/unfreeze_best.h5
INPUT_SIZE=224

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS - Allowed Frontend Origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Confidence Thresholds for UI presentation
CONFIDENCE_HIGH=80
CONFIDENCE_MEDIUM=60

# Human-skin validator threshold (MobileNetV2 sigmoid cutoff)
SKIN_VALIDATOR_THRESHOLD=0.5

# Calibration Configuration (Guo et al., 2017)
# Temperature T=1.492 was fitted strictly on validation data negative log-likelihood.
CALIBRATION_ENABLED=true
CALIBRATION_TEMPERATURE=1.492

# Classifier confidence fallback (calibrated threshold)
# Primary close-up predictions with confidence strictly below 60.0% trigger low-confidence rejection.
# Note: The 60.0% threshold was selected after exploratory threshold sweeps that included the test set.
CLASSIFIER_CONFIDENCE_FALLBACK=60.0
